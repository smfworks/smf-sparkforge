<Window x:Class="SparkForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SparkForge.ViewModels"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SparkForge" Height="700" Width="1000"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e2e">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewConversationCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#181825" BorderBrush="#313244" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="16,16,16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Local AI" FontSize="20" FontWeight="Bold" Foreground="#cdd6f4"/>
                        <Button Grid.Column="1" Width="32" Height="32"
                                Command="{Binding ToggleThemeCommand}"
                                Background="Transparent" BorderThickness="0"
                                ToolTip="Toggle theme"
                                FontSize="16" Content="{Binding ThemeIcon}"/>
                    </Grid>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#a6adc8"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Model Selector -->
                <StackPanel Grid.Row="0" Margin="16,70,16,0">
                    <TextBlock Text="Model" FontSize="11" Foreground="#585b70" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Models}"
                              SelectedItem="{Binding SelectedModel}"
                              DisplayMemberPath="Name"
                              Background="#313244" Foreground="#cdd6f4"
                              BorderBrush="#45475a" Height="32"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="0" Margin="16,120,16,0">
                    <Button Height="32"
                            Command="{Binding NewConversationCommand}"
                            Background="#45475a" Foreground="#cdd6f4"
                            BorderBrush="#585b70" Content="+ New Chat (Ctrl+N)"
                            HorizontalAlignment="Stretch" Margin="0,0,0,4"
                            FontSize="11"/>
                    <Button Height="28"
                            Command="{Binding ReconnectCommand}"
                            Background="#313244" Foreground="#f9e2af"
                            BorderBrush="#45475a" FontSize="11"
                            HorizontalAlignment="Stretch" Margin="0,0,0,4">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Margin="0,0,6,0"/>
                                <TextBlock Text="Reconnect"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Height="28"
                            Command="{Binding EditSystemPromptCommand}"
                            Background="#313244" Foreground="#cba6f7"
                            BorderBrush="#45475a" FontSize="11"
                            HorizontalAlignment="Stretch" Margin="0,0,0,4">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Margin="0,0,6,0"/>
                                <TextBlock Text="System Prompt"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>

                <!-- Conversation List -->
                <ListBox Grid.Row="1" Margin="8,8,8,8"
                         ItemsSource="{Binding Conversations}"
                         SelectedItem="{Binding SelectedConversation}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#cdd6f4"
                         x:Name="ConversationListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="#cdd6f4"/>
                                    <TextBlock Text="{Binding Model}" FontSize="10" Foreground="#585b70"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="✏" Width="22" Height="22"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#585b70" FontSize="10"
                                            ToolTip="Rename"
                                            Click="OnRenameClick"
                                            Tag="{Binding}"/>
                                    <Button Content="✕" Width="22" Height="22"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#f38ba8" FontSize="10"
                                            ToolTip="Delete"
                                            Click="OnDeleteClick"
                                            Tag="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Bottom Actions -->
                <StackPanel Grid.Row="2" Margin="16,8,16,16">
                    <Button Content="Download Models" Height="28"
                            Command="{Binding PullModelCommand}"
                            Background="#313244" Foreground="#89b4fa"
                            BorderBrush="#45475a" FontSize="12" Margin="0,0,0,4"/>
                    <Button Content="Benchmark" Height="28"
                            Command="{Binding BenchmarkCommand}"
                            Background="#313244" Foreground="#a6e3a1"
                            BorderBrush="#45475a" FontSize="12" Margin="0,0,0,4"/>
                    <Button Content="Open Logs" Height="28"
                            Command="{Binding OpenLogsCommand}"
                            Background="#313244" Foreground="#585b70"
                            BorderBrush="#45475a" FontSize="12" Margin="0,0,0,8"/>
                    <Border Background="#313244" CornerRadius="6" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{Binding HardwareInfo.Summary}" FontSize="10"
                                       Foreground="#a6adc8" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock FontSize="10" Foreground="#585b70">
                                <Run Text="{Binding HardwareInfo.AccelerationEngine, Mode=OneWay}"/>
                                <Run Text=" • "/>
                                <Run Text="{Binding HardwareInfo.RecommendedModelSize, StringFormat='Best: {0} models', Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Messages (WebView2 for rich Markdown) -->
            <Border Grid.Row="0" Background="#1e1e2e">
                <wpf:WebView2 x:Name="ChatWebView"/>
            </Border>

            <!-- Streaming indicator -->
            <Border Grid.Row="0" VerticalAlignment="Bottom" Margin="16,0,16,8"
                    Background="#313244" CornerRadius="8" Padding="12,8"
                    Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StreamingResponse}" FontSize="13"
                           Foreground="#cdd6f4" TextWrapping="Wrap" MaxHeight="200"/>
            </Border>

            <!-- Input Bar -->
            <Border Grid.Row="1" Background="#181825" BorderBrush="#313244" BorderThickness="0,1,0,0">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             Background="#313244" Foreground="#cdd6f4"
                             BorderBrush="#45475a" CaretBrush="#cdd6f4"
                             Padding="12,8" FontSize="13"
                             AcceptsReturn="False"
                             TextWrapping="Wrap" MaxHeight="120"
                             IsEnabled="{Binding IsOllamaRunning}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}"/>
                            <KeyBinding Key="Enter" Modifiers="Shift" Command="{Binding SendMessageCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="1" Content="Stop" Margin="8,0,0,0"
                            Width="50" Height="32"
                            Command="{Binding StopGenerationCommand}"
                            Background="#f38ba8" Foreground="#1e1e2e"
                            BorderThickness="0" FontSize="12" FontWeight="Bold"
                            Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}"/>

                    <Button Grid.Column="2" Content="Send" Margin="8,0,0,0"
                            Width="60" Height="32"
                            Command="{Binding SendMessageCommand}"
                            Background="#89b4fa" Foreground="#1e1e2e"
                            BorderThickness="0" FontSize="12" FontWeight="Bold"
                            IsEnabled="{Binding CanSend}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
