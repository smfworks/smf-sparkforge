<Window x:Class="SparkForge.Views.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to SparkForge" Height="520" Width="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#1e1e2e" CornerRadius="12" BorderBrush="#313244" BorderThickness="1">
        <Grid Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="SparkForge" FontSize="20" FontWeight="Bold" Foreground="#cdd6f4"/>
                <TextBlock Text="Setup Wizard" FontSize="13" Foreground="#585b70" Margin="0,24,0,0"/>
            </Grid>

            <!-- Step Content (switched via code-behind) -->
            <Grid Grid.Row="1" x:Name="ContentArea">
                <!-- Step 1: Welcome & Ollama Check -->
                <Grid x:Name="Step1" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Let's get you set up with local AI" FontSize="16"
                                   Foreground="#cdd6f4" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Text="This app lets you chat with AI models running entirely on your computer. Nothing leaves your machine." FontSize="13"
                                   Foreground="#a6adc8" TextWrapping="Wrap" Margin="0,0,0,24"/>

                        <Border Background="#313244" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OllamaStatusIcon" Grid.Column="0" Text="..." FontSize="24"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="OllamaStatusText" Text="Checking for Ollama..."
                                               FontSize="13" Foreground="#cdd6f4" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OllamaStatusDetail" Text="" FontSize="11"
                                               Foreground="#a6adc8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="OllamaActionPanel" Background="#45475a" CornerRadius="8"
                                Padding="16,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="OllamaActionText" Text="" FontSize="12"
                                           Foreground="#cdd6f4" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button x:Name="OllamaActionButton" Content="Download Ollama"
                                        Width="180" Height="32" Click="OnInstallOllamaClick"
                                        Background="#89b4fa" Foreground="#1e1e2e"
                                        BorderThickness="0" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Step 2: Hardware Detection & Model Recommendation -->
                <Grid x:Name="Step2" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Your Hardware" FontSize="16"
                                   Foreground="#cdd6f4" Margin="0,0,0,12"/>

                        <Border Background="#313244" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="GPU" FontSize="12" Foreground="#585b70"/>
                                <TextBlock Grid.Column="1" x:Name="HwGpu" Text="Detecting..."
                                           FontSize="12" Foreground="#cdd6f4"/>
                            </Grid>
                        </Border>

                        <Border Background="#313244" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="System RAM" FontSize="12" Foreground="#585b70"/>
                                <TextBlock Grid.Column="1" x:Name="HwRam" Text="Detecting..."
                                           FontSize="12" Foreground="#cdd6f4"/>
                            </Grid>
                        </Border>

                        <Border Background="#313244" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="NPU" FontSize="12" Foreground="#585b70"/>
                                <TextBlock Grid.Column="1" x:Name="HwNpu" Text="Detecting..."
                                           FontSize="12" Foreground="#cdd6f4"/>
                            </Grid>
                        </Border>

                        <Border Background="#1e1e2e" CornerRadius="8" Padding="16,12" Margin="0,12,0,0"
                                BorderBrush="#45475a" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Recommended Models" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#cdd6f4" Margin="0,0,0,8"/>
                                <TextBlock x:Name="HwRecommendation" Text=""
                                           FontSize="12" Foreground="#a6adc8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Step 3: Download Recommended Model -->
                <Grid x:Name="Step3" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Download Your First Model" FontSize="16"
                                   Foreground="#cdd6f4" Margin="0,0,0,12"/>
                        <TextBlock Text="Choose a model to download. Smaller models are faster but less capable. You can always download more later." FontSize="12"
                                   Foreground="#a6adc8" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <ListBox x:Name="RecommendedModelList" Background="Transparent"
                                 BorderThickness="0" Margin="0,0,0,16">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#313244" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#cdd6f4"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="#a6adc8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                <TextBlock FontSize="10" Foreground="#585b70" Margin="0,2,0,0">
                                                    <Run Text="{Binding ParameterSize, Mode=OneWay}"/>
                                                    <Run Text=" • "/>
                                                    <Run Text="{Binding SizeFormatted, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected}" Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Download Progress -->
                        <Border x:Name="DownloadProgressPanel" Background="#313244" CornerRadius="8"
                                Padding="14,10" Visibility="Collapsed" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="DownloadProgressLabel" Text="Downloading..."
                                           FontSize="12" Foreground="#cdd6f4" Margin="0,0,0,6"/>
                                <ProgressBar x:Name="DownloadProgressBar" Height="6"
                                             Background="#1e1e2e" Foreground="#89b4fa" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="DownloadButton" Content="Download Selected"
                                Width="180" Height="32" Click="OnDownloadModelsClick"
                                Background="#89b4fa" Foreground="#1e1e2e"
                                BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>

                <!-- Step 4: Ready! -->
                <Grid x:Name="Step4" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="You're all set!" FontSize="22" FontWeight="Bold"
                                   Foreground="#a6e3a1" Margin="0,0,0,12"/>
                        <TextBlock Text="Your local AI is ready to use. Everything runs on your computer — private, fast, and free." FontSize="13"
                                   Foreground="#cdd6f4" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ReadyModelsText" Text="" FontSize="12"
                                   Foreground="#a6adc8" TextWrapping="Wrap" Margin="0,0,0,24"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="AutoStartCheck" Grid.Column="0" Content=""
                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                      Foreground="#cdd6f4"/>
                            <TextBlock Grid.Column="1" Text="Start SparkForge when Windows starts"
                                       FontSize="12" Foreground="#a6adc8" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Navigation Buttons -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Step indicators -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="#89b4fa" Margin="0,0,4,0"/>
                    <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="#45475a" Margin="0,0,4,0"/>
                    <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="#45475a" Margin="0,0,4,0"/>
                    <Ellipse x:Name="Dot4" Width="8" Height="8" Fill="#45475a"/>
                </StackPanel>

                <Button x:Name="BackButton" Grid.Column="1" Content="Back" Width="80" Height="32"
                        Click="OnBackClick" Visibility="Collapsed"
                        Background="#45475a" Foreground="#cdd6f4"
                        BorderBrush="#585b70" FontSize="12" Margin="0,0,8,0"/>

                <Button x:Name="NextButton" Grid.Column="2" Content="Next" Width="80" Height="32"
                        Click="OnNextClick"
                        Background="#89b4fa" Foreground="#1e1e2e"
                        BorderThickness="0" FontSize="12" FontWeight="SemiBold"/>
            </Grid>
        </Grid>
    </Border>
</Window>
