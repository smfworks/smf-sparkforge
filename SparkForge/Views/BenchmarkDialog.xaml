<Window x:Class="SparkForge.Views.BenchmarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Benchmark Models" Height="480" Width="550"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Background="#1e1e2e"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Benchmark Models" FontSize="18" FontWeight="Bold" Foreground="#cdd6f4"/>
            <TextBlock Text="Test inference speed for each installed model" FontSize="12" Foreground="#a6adc8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Test prompt" FontSize="11" Foreground="#585b70" Margin="0,0,0,4"/>
                <TextBox x:Name="TestPrompt" Text="Explain the concept of recursion in one paragraph."
                         Background="#313244" Foreground="#cdd6f4" BorderBrush="#45475a"
                         CaretBrush="#cdd6f4" Padding="10,8" FontSize="12"
                         TextWrapping="Wrap" Height="40"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Run Benchmark" Width="120" Height="40"
                    Click="OnRunBenchmark" Margin="12,18,0,0"
                    Background="#89b4fa" Foreground="#1e1e2e"
                    BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                    VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Results -->
        <Border Grid.Row="2" Background="#181825" BorderBrush="#313244"
                BorderThickness="1" CornerRadius="6">
            <ListView x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                      Foreground="#cdd6f4">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Model" Width="140" DisplayMemberBinding="{Binding ModelName}"/>
                        <GridViewColumn Header="Tokens/s" Width="80" DisplayMemberBinding="{Binding TokensPerSec}"/>
                        <GridViewColumn Header="Time" Width="70" DisplayMemberBinding="{Binding TotalTime}"/>
                        <GridViewColumn Header="Tokens" Width="70" DisplayMemberBinding="{Binding TotalTokens}"/>
                        <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding Status}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Summary -->
        <Border Grid.Row="3" x:Name="SummaryPanel" Background="#313244" CornerRadius="6"
                Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="SummaryText" FontSize="12" Foreground="#cdd6f4" TextWrapping="Wrap"/>
                <TextBlock x:Name="RecommendationText" FontSize="11" Foreground="#a6adc8"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
