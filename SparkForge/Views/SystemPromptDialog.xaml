<Window x:Class="SparkForge.Views.SystemPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Prompt" Height="400" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#1e1e2e">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="System Prompt" FontSize="16" FontWeight="Bold" Foreground="#cdd6f4"/>
            <TextBlock Text="Instructions that set the behavior of the AI assistant for this conversation."
                       FontSize="11" Foreground="#585b70" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="PromptTextBox"
                 Background="#313244" Foreground="#cdd6f4"
                 BorderBrush="#45475a" CaretBrush="#cdd6f4"
                 Padding="12" FontSize="13" FontFamily="Cascadia Code, Consolas, monospace"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Height="32"
                    Click="Cancel_Click"
                    Background="#45475a" Foreground="#cdd6f4"
                    BorderBrush="#585b70" Margin="0,0,8,0"/>
            <Button Content="Save" Width="80" Height="32"
                    Click="Save_Click"
                    Background="#89b4fa" Foreground="#1e1e2e"
                    BorderThickness="0" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
